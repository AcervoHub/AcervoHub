generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookReadingStatus {
  QUERO_LER
  LIDOS
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  avatarUrl String?
  createdAt DateTime @default(now())
  bio String?

  library UserBook[]
}

model Book {
  id            String   @id @default(cuid())
  googleBooksId String   @unique
  isbn10        String?  @unique
  isbn13        String?  @unique
  title         String
  subtitle      String?
  authors       String[]
  description   String?
  publisher     String?
  thumbnail     String?
  coverUrl      String?
  publishedDate String?
  pageCount     Int?
  language      String?
  categories    String[]
  createdAt     DateTime @default(now())
  users UserBook[]
}

model UserBook {
  id      String   @id @default(cuid())
  userId  String
  bookId  String
  status  BookReadingStatus @default(QUERO_LER)
  isFavorite Boolean @default(false)
  rating  Int?
  comment String?
  startedAt DateTime?
  finishedAt DateTime?
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book     Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  favorite Favorite?
  review   Review?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  createdAt DateTime @default(now())

  userBook UserBook @relation(fields: [userId, bookId], references: [userId, bookId], onDelete: Cascade)

  @@unique([userId, bookId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  rating    Int?
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userBook UserBook @relation(fields: [userId, bookId], references: [userId, bookId], onDelete: Cascade)

  @@unique([userId, bookId])
}